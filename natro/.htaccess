# ESEA Agency – Natro (Apache / cPanel) ayarları

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https ve www → www'siz, tek adımda (site kayıtlarındaki adres: https://eseaagency.com/)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://eseaagency.com%{REQUEST_URI} [L,R=301]

  # nokta ile başlayan gizli dosyalara (.htaccess, .git vb.) erişimi kapat
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<IfModule mod_headers.c>
  # Tarayıcıya siteyi hep https ile açmasını söyler (alt alan adları hariç: webmail/cpanel'de sertifika yok)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Yalnızca sitenin kendi dosyaları çalışır/yüklenir (dış betik, iframe, eklenti engellenir)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Sunucu yazılım sürümünü dışarıya gösterme
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # HTML ve veri dosyası her zaman güncel; sürümlü CSS/JS, font ve görseller uzun süre önbellekte
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
